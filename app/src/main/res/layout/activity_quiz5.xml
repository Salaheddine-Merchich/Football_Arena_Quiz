<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    tools:context=".Quiz5">

    <!-- Top Status Bar -->
    <LinearLayout
        android:id="@+id/llStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvContinent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📍 Region"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:alpha="0.7" />

        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="15s"
            android:textColor="@color/football_gold"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCurrentScore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="Score: 0"
            android:textColor="@color/football_gold"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="MATCH 5 / 20"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:alpha="0.6"
        app:layout_constraintEnd_toEndOf="@id/llStatus"
        app:layout_constraintTop_toBottomOf="@id/llStatus" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/quizProgressBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:indicatorColor="@color/football_gold"
        app:layout_constraintEnd_toEndOf="@id/llStatus"
        app:layout_constraintStart_toStartOf="@id/llStatus"
        app:layout_constraintTop_toBottomOf="@id/tvProgress"
        app:trackColor="#22FFFFFF"
        app:trackCornerRadius="4dp"
        app:trackThickness="8dp"
        android:progress="25" />

    <!-- Main Question Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="@color/surface_dark"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp"
        app:layout_constraintTop_toBottomOf="@id/quizProgressBar"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivQuestion"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true"
                android:src="@drawable/quiz_banner"
                android:contentDescription="Question Image" />

            <TextView
                android:id="@+id/tvQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp"
                android:text="Question text..."
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:lineSpacingExtra="6dp"
                android:gravity="center" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Answers -->
    <RadioGroup
        android:id="@+id/rgOptions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toTopOf="@id/llBottomActions"
        app:layout_constraintTop_toBottomOf="@id/cardQuestion">

        <RadioButton
            android:id="@+id/rbOptionA"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_choice_selector"
            android:button="@null"
            android:paddingHorizontal="24dp"
            android:text="Option A"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:gravity="center_vertical" />

        <RadioButton
            android:id="@+id/rbOptionB"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_choice_selector"
            android:button="@null"
            android:paddingHorizontal="24dp"
            android:text="Option B"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:gravity="center_vertical" />

        <RadioButton
            android:id="@+id/rbOptionC"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_choice_selector"
            android:button="@null"
            android:paddingHorizontal="24dp"
            android:text="Option C"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:gravity="center_vertical" />

        <RadioButton
            android:id="@+id/rbOptionD"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_choice_selector"
            android:button="@null"
            android:paddingHorizontal="24dp"
            android:text="Option D"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:gravity="center_vertical" />
    </RadioGroup>

    <!-- Bottom Actions -->
    <LinearLayout
        android:id="@+id/llBottomActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabMic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:src="@android:drawable/ic_btn_speak_now"
            app:backgroundTint="@color/football_gold"
            app:tint="@color/bg_dark"
            app:fabSize="normal"
            android:contentDescription="Voice Answer" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bNext"
            style="@style/Widget.QuizApp.Button.Gold"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:text="FINISH MATCH"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:elevation="8dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>